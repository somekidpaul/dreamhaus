<script>
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible')}});
  },{threshold:0.12});
  document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));

  // Fade-in-by-character reveal triggered when CTA headline scrolls into view
  const ctaHeadline = document.getElementById('ctaHeadline');
  if(ctaHeadline){
    // Wrap each word in a non-breaking inline-block group, each char fades in individually
    const text = ctaHeadline.textContent;
    ctaHeadline.textContent = '';
    const chars = [];
    const words = text.split(' ');
    words.forEach((word, wi)=>{
      const wordSpan = document.createElement('span');
      wordSpan.className = 'word';
      for(let i = 0; i < word.length; i++){
        const span = document.createElement('span');
        span.className = 'ch';
        span.textContent = word[i];
        wordSpan.appendChild(span);
        chars.push(span);
      }
      ctaHeadline.appendChild(wordSpan);
      // Add a normal text space between words (allows wrapping at word boundaries)
      if(wi < words.length - 1){
        ctaHeadline.appendChild(document.createTextNode(' '));
      }
    });

    const ctaObserver = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{
        if(e.isIntersecting && !ctaHeadline.dataset.revealed){
          ctaHeadline.dataset.revealed = '1';
          // Stagger character reveals - 60ms each
          chars.forEach((c, i)=>{
            setTimeout(()=>c.classList.add('show'), i * 60);
          });
          // After all chars are in (~text.length * 60ms + transition), turn on flicker + sparkles
          const totalRevealMs = chars.length * 60 + 500;
          setTimeout(()=>{
            ctaHeadline.classList.add('typed');
            const twinkles = document.querySelectorAll('.cta-twinkle');
            twinkles.forEach((t,i)=>{
              setTimeout(()=>t.classList.add('show'), i*120);
            });
          }, totalRevealMs);
        }
      });
    },{threshold:0.5});
    ctaObserver.observe(ctaHeadline);
  }


  // Back to top button
  const backToTop = document.getElementById('backToTop');
  if(backToTop){
    window.addEventListener('scroll', ()=>{
      if(window.scrollY > 500){backToTop.classList.add('visible')}
      else{backToTop.classList.remove('visible')}
    });
    backToTop.addEventListener('click', ()=>{
      window.scrollTo({top:0, behavior:'smooth'});
    });
  }

  const toggle = document.getElementById('mobileToggle');
  const links = document.getElementById('navLinks');
  if(toggle){
    toggle.addEventListener('click',()=>{links.classList.toggle('open')});
    links.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>links.classList.remove('open')));
  }
</script>


