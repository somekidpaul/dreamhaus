    .spotlight-name{font-size:34px}
    .spotlight-role{font-size:28px}
    .spotlight-bio{font-size:14px}
  }
  /* ============== CTA "Ready to live the dream" ============== */
  .cta-strip{
    padding:120px 40px 140px;
    margin:60px 0 0;
    text-align:center;
    position:relative;
    overflow:hidden;
    min-height:520px;
  }
  /* Floating heart cloud behind the CTA content */
  .cta-heart{
    position:absolute;
    pointer-events:none;
    animation:cta-float 8s ease-in-out infinite;
    z-index:1;
  }
  @keyframes cta-float{
    0%,100%{transform:translateY(0) rotate(-8deg)}
    50%{transform:translateY(-25px) rotate(8deg)}
  }
  /* Sparkle hearts that pulse */
  .cta-sparkle{
    position:absolute;
    pointer-events:none;
    animation:cta-sparkle 3s ease-in-out infinite;
    z-index:1;
  }
  @keyframes cta-sparkle{
    0%,100%{opacity:.3;transform:scale(0.8)}
    50%{opacity:1;transform:scale(1.15)}
  }
  /* Content sits on top */
  .cta-content{
    position:relative;
    z-index:5;
    max-width:800px;
    margin:0 auto;
  }
  .cta-strip h2{
    font-family:'Sacramento',cursive;
    font-size:clamp(64px,7vw,110px);
    font-weight:400;
    line-height:1;
    margin-bottom:18px;
    position:relative;
    display:inline-block;
    color:var(--hot-pink);
    /* Stronger neon glow stack for boldness on light bg */
    text-shadow:
      0 0 1px #fff,
      0 0 6px #fff,
      0 0 14px rgba(255,20,147,0.85),
      0 0 28px rgba(255,20,147,0.65),
      0 0 48px rgba(255,0,128,0.55),
      0 2px 4px rgba(255,20,147,0.3);
    max-width:100%;
    padding:0 0.1em;
  }
  @media(max-width:560px){
    .cta-strip h2{
      font-size:62px;
      line-height:0.95;
    }
  }
  /* Words stay together as units (won't break mid-word on wrap) */
  .cta-strip h2 .word{
    display:inline-block;
    white-space:nowrap;
  }
  /* Each character starts hidden, fades in via JS */
  .cta-strip h2 .ch{
    display:inline-block;
    opacity:0;
    transform:translateY(8px) scale(0.92);
    transition:opacity 0.4s ease, transform 0.4s ease;
  }
  .cta-strip h2 .ch.show{
    opacity:1;
    transform:translateY(0) scale(1);
  }
  /* Once fully revealed, flicker like the logo */
  .cta-strip h2.typed{
    animation:cta-flicker 4s infinite;
  }
  /* Logo-style neon flicker - kicks in after typing completes */
  @keyframes cta-flicker{
    0%,17%,20%,24%,52%,55%,100%{
      text-shadow:
        0 0 1px #fff,
        0 0 4px rgba(255,255,255,0.8),
        0 0 12px rgba(255,20,147,0.7),
        0 0 24px rgba(255,20,147,0.5),
        0 0 40px rgba(255,0,128,0.4);
      opacity:1;
    }
    19%,22%,54%{
      text-shadow:0 0 2px rgba(255,20,147,0.4);
      opacity:0.7;
    }
    35%{
      text-shadow:
        0 0 2px #fff,
        0 0 8px #fff,
        0 0 16px rgba(255,20,147,0.9),
        0 0 32px rgba(255,20,147,0.7),
        0 0 56px rgba(255,0,128,0.6);
      opacity:1;
    }
  }
  /* Sparkle decorations around the headline */
  .cta-sparkles-wrap{
    position:relative;
    display:inline-block;
    z-index:5;
  }
  .cta-twinkle{
    position:absolute;
    pointer-events:none;
    opacity:0;
    z-index:6;
  }
  .cta-twinkle.show{
    animation:cta-twinkle 2s ease-in-out infinite;
  }
  @keyframes cta-twinkle{
    0%,100%{opacity:0;transform:scale(0.4) rotate(0deg)}
    50%{opacity:1;transform:scale(1.2) rotate(180deg)}
  }
  .cta-strip p{
    font-family:'Outfit',sans-serif;
    font-size:18px;
    line-height:1.7;
    color:var(--deep);
    margin-bottom:40px;
    position:relative;
    max-width:480px;
    margin-left:auto;
    margin-right:auto;
  }
  /* Glowing pulse CTA button */
  .cta-strip .cta-primary{
    background:linear-gradient(135deg,var(--hot-pink),var(--magenta));
    color:#fff;
    position:relative;
    box-shadow:0 14px 40px rgba(255,20,147,0.45);
    animation:cta-pulse 2.5s ease-in-out infinite;
  }
  @keyframes cta-pulse{
    0%,100%{box-shadow:0 14px 40px rgba(255,20,147,0.45),0 0 0 0 rgba(255,20,147,0.4)}
    50%{box-shadow:0 14px 40px rgba(255,20,147,0.55),0 0 0 16px rgba(255,20,147,0)}
  }
  .cta-strip .cta-primary:hover{
    transform:translateY(-4px) scale(1.03);
    background:linear-gradient(135deg,var(--magenta),var(--hot-pink));
    animation:none;
    box-shadow:0 20px 50px rgba(255,20,147,0.6);
  }

  /* FOOTER */
  footer{background:var(--ink);color:#fff;padding:80px 40px 30px;position:relative}
  .footer-grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;margin-bottom:60px}
  .footer-logo{height:50px;margin-bottom:18px;filter:drop-shadow(0 0 6px var(--hot-pink)) drop-shadow(0 0 18px var(--hot-pink))}
  footer .footer-tag{font-family:'Outfit',sans-serif !important;font-size:14px !important;font-weight:400;color:var(--cotton);max-width:340px;line-height:1.65;opacity:0.9}
  .footer-col h4{font-family:'Outfit',sans-serif;font-weight:700;font-size:11px;letter-spacing:2px;color:var(--hot-pink);margin-bottom:18px;text-transform:uppercase}
  .footer-col a, .footer-col p{display:block;color:rgba(255,255,255,0.7);text-decoration:none;font-size:14px;margin-bottom:10px;transition:color .3s}
  .footer-col a:hover{color:var(--bubblegum)}
  .footer-bottom{
    border-top:1px solid rgba(255,255,255,0.1);
    padding-top:30px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    flex-wrap:wrap;
    font-size:12px;
    color:rgba(255,255,255,0.5);
    letter-spacing:1px;
  }
  .footer-bottom a{
    color:rgba(255,255,255,0.5);
    text-decoration:none;
    transition:color .3s;
    display:inline-flex;
    align-items:center;
    gap:6px;
  }
  .footer-bottom a:hover{color:var(--bubblegum)}
  @media(max-width:520px){
    .footer-bottom{justify-content:center;text-align:center;flex-direction:column;gap:14px}
  }
  @media(max-width:880px){.footer-grid{grid-template-columns:1fr 1fr;gap:40px}}
  @media(max-width:520px){.footer-grid{grid-template-columns:1fr}.cta-strip{padding:80px 20px 100px;min-height:auto}.cta-heart{display:none}.cta-heart.keep-mobile{display:block}}

  .reveal{opacity:0;transform:translateY(40px);transition:opacity .9s ease, transform .9s ease}
  .reveal.visible{opacity:1;transform:translateY(0)}

  @media(max-width:780px){
    .hero{padding:120px 20px 60px}
    .hero-heart{display:none}
    .hero-heart.h1,.hero-heart.h2{display:block;width:80px;opacity:.6}
    .marquee-item{font-size:26px}
    .ugc,.team,.services,.reviews,.faq{padding:80px 20px}
  }

  /* === Responsive title breaks === */
  @media(max-width:780px){
    /* Tighter section spacing on mobile */
    .section-header{margin-bottom:36px}
    .section-title{line-height:1.0}
    
    /* CHO 3-line heading - tight, no extra gaps from em line-box */
    .chos .section-title .cho-l1,
    .chos .section-title .cho-l2,
    .chos .section-title .cho-l3{
      display:block;
      line-height:1.0;
      margin:0;
      padding:0;
    }
    .chos .section-title em.cho-l2{
      font-size:1.1em;
      padding:0;
    }
    
    .ugc .section-title .line1, .ugc .section-title .line2{display:block}
    .reviews .section-title .line1, .reviews .section-title .line2{display:block}
    
    /* Services pricing intro - tighter top margin on mobile */
    .services .section-header{margin-bottom:20px}
    .services > p.reveal{margin-top:0}
  }
  @media(max-width:560px){
    .hero-tagline .tag-sep{display:none}
    .hero-tagline .tag-line1, .hero-tagline .tag-line2{display:block}
  }

  /* === Back to top heart button === */
  .back-to-top{
    position:fixed;
    bottom:24px;
    right:24px;
    width:54px;
    height:54px;
    background:linear-gradient(135deg,#ff1493,#ff0080);
    border:none;
    border-radius:50%;
    box-shadow:0 8px 24px rgba(255,20,147,0.45),0 0 0 0 rgba(255,20,147,0.4);
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    opacity:0;
    visibility:hidden;
    transform:translateY(20px) scale(0.8);
    transition:all 0.3s ease;
    z-index:100;
    animation:btt-pulse 2.5s ease-in-out infinite;
  }
  .back-to-top.visible{
    opacity:1;
    visibility:visible;
    transform:translateY(0) scale(1);
  }
  .back-to-top:hover{
    transform:translateY(-4px) scale(1.05);
    box-shadow:0 14px 32px rgba(255,20,147,0.6);
  }
  .back-to-top svg{
    width:26px;
    height:26px;
    fill:#fff;
    filter:drop-shadow(0 1px 2px rgba(0,0,0,0.15));
  }
  @keyframes btt-pulse{
    0%,100%{box-shadow:0 8px 24px rgba(255,20,147,0.45),0 0 0 0 rgba(255,20,147,0.4)}
    50%{box-shadow:0 8px 24px rgba(255,20,147,0.55),0 0 0 12px rgba(255,20,147,0)}
  }
  @media(max-width:780px){
    .back-to-top{width:48px;height:48px;bottom:20px;right:16px}
    .back-to-top svg{width:22px;height:22px}
  }
</style>
</head>
