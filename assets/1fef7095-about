<style>
  :root{
    --hot-pink:#ff1493;
    --magenta:#ff0080;
    --bubblegum:#ff6fc8;
    --neon:#ff2d8a;
    --cotton:#ffd1ec;
    --baby:#ffe6f3;
    --blush:#ffeef6;
    --cream:#fff8fc;
    --deep:#c9006b;
    --ink:#2a0a1a;
    --gold-tier:#ffcc66;
  }

  /* Hot pink heart cursor - applied site-wide */
  body {
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32"><path d="M16 28.5l-2-1.85C7.4 20.5 3 16.4 3 11.4 3 7.3 6.3 4 10.4 4c2.3 0 4.5 1.1 6 2.8 1.5-1.7 3.7-2.8 6-2.8 4.1 0 7.4 3.3 7.4 7.4 0 5-4.4 9.1-11 15.25L16 28.5z" fill="%23ff1493" stroke="%23ffffff" stroke-width="1.5" stroke-linejoin="round" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.25))"/></svg>') 6 4, auto;
  }
  a, button, summary, [role="button"], .cta-primary, .cta-secondary, .book-btn,
  .ugc-tile, .team-card, .cho-card, .service-card, .review-card,
  .nav-links a, .nav-logo, .footer-col a, .footer-logo {
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32"><path d="M16 28.5l-2-1.85C7.4 20.5 3 16.4 3 11.4 3 7.3 6.3 4 10.4 4c2.3 0 4.5 1.1 6 2.8 1.5-1.7 3.7-2.8 6-2.8 4.1 0 7.4 3.3 7.4 7.4 0 5-4.4 9.1-11 15.25L16 28.5z" fill="%23ff1493" stroke="%23ffffff" stroke-width="1.5" stroke-linejoin="round" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.25))"/></svg>') 6 4, pointer;
  }
  /* Inputs and text-selectable areas keep default cursor for usability */
  input, textarea, select, [contenteditable] {
    cursor: text;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{font-family:'Outfit',sans-serif;background:var(--cream);color:var(--ink);overflow-x:hidden}
  ::selection{background:var(--hot-pink);color:#fff}

  .bg{
    position:fixed;inset:0;z-index:-2;
    background:
      radial-gradient(ellipse 80% 50% at 20% 0%, #ffb3dc 0%, transparent 60%),
      radial-gradient(ellipse 70% 50% at 100% 30%, #ff8ec7 0%, transparent 55%),
      radial-gradient(ellipse 70% 50% at 0% 80%, #ffc4e3 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 100%, #ffb3dc 0%, transparent 60%),
      linear-gradient(180deg,#fff0f8 0%, #ffd6ec 100%);
  }

  .petal{position:fixed;width:18px;height:18px;pointer-events:none;z-index:1;opacity:.7;animation:fall linear infinite}
  .petal svg{width:100%;height:100%}
  @keyframes fall{
    0%{transform:translateY(-10vh) rotate(0deg);opacity:0}
    10%,90%{opacity:.8}
    100%{transform:translateY(110vh) rotate(720deg);opacity:0}
  }

  /* NAV */
  nav{
    position:fixed;top:0;left:0;right:0;z-index:100;
    padding:18px 40px;display:flex;justify-content:space-between;align-items:center;
    background:var(--ink);
    border-bottom:1px solid rgba(255,20,147,0.4);
    box-shadow:0 4px 20px rgba(0,0,0,0.15);
  }
  .nav-logo{height:44px;filter:drop-shadow(0 0 8px rgba(255,20,147,0.6)) drop-shadow(0 0 16px rgba(255,20,147,0.3));animation:nav-flicker 5s infinite}
  @keyframes nav-flicker{
    0%,17%,21%,24%,52%,56%,100%{filter:drop-shadow(0 0 8px rgba(255,20,147,0.6)) drop-shadow(0 0 16px rgba(255,20,147,0.3));opacity:1}
    19%,23%,55%{filter:drop-shadow(0 0 4px rgba(255,20,147,0.4));opacity:.7}
  }
  .nav-links{display:flex;gap:32px;list-style:none;align-items:center}
  .nav-links a{text-decoration:none;color:#fff;font-size:12px;font-weight:600;letter-spacing:1.6px;text-transform:uppercase;position:relative;transition:color .3s}
  .nav-links a::after{content:"";position:absolute;bottom:-6px;left:0;width:0;height:2px;background:var(--bubblegum);transition:width .35s ease}
  .nav-links a:hover{color:var(--bubblegum)}
  .nav-links a:hover::after{width:100%}
  .book-btn{background:var(--hot-pink);color:white;padding:11px 22px;border-radius:999px;border:none;cursor:pointer;font-size:11px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;box-shadow:0 6px 20px rgba(255,20,147,0.45);transition:all .3s;text-decoration:none}
  .book-btn:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(255,20,147,0.6)}
  .mobile-toggle{display:none;background:none;border:none;font-size:26px;color:var(--hot-pink);cursor:pointer}
  @media(max-width:980px){
    nav{padding:14px 20px;justify-content:flex-end}
    nav > a:first-child{
      position:absolute;
      left:50%;
      top:50%;
      transform:translate(-50%,-50%);
    }
    .nav-links{display:none}
    .mobile-toggle{display:block}
    .nav-links.open{display:flex;flex-direction:column;position:absolute;top:100%;right:20px;background:var(--ink);padding:24px;border-radius:18px;box-shadow:0 10px 30px rgba(0,0,0,0.4);gap:18px;border:1px solid rgba(255,20,147,0.3)}
  }

  /* HERO */
  .hero{min-height:100vh;padding:140px 40px 100px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative}
  .hero-heart{position:absolute;pointer-events:none;animation:sway 6s ease-in-out infinite}
  .hero-heart.h1{top:8%;left:5%;width:140px;animation-delay:-1s}
  .hero-heart.h2{top:15%;right:6%;width:180px;animation-delay:-3s}
  .hero-heart.h3{bottom:10%;left:8%;width:110px;animation-delay:-2s}
  .hero-heart.h4{bottom:18%;right:10%;width:130px;animation-delay:-4s}
  .hero-heart.h5{top:45%;left:2%;width:80px;animation-delay:-2.5s}
  .hero-heart.h6{top:55%;right:3%;width:90px;animation-delay:-1.5s}
  @keyframes sway{0%,100%{transform:rotate(-5deg) translateY(0)}50%{transform:rotate(5deg) translateY(-15px)}}

  .glow-logo-wrap{position:relative;display:inline-block;padding:30px 50px;margin-bottom:40px}
  .glow-logo{
    max-width:520px;width:80vw;height:auto;
    position:relative;
    z-index:2;
    filter:drop-shadow(0 0 12px rgba(255,20,147,0.5));
    animation:logo-flicker 4s infinite;
  }
  @keyframes logo-flicker{
    0%,17%,20%,24%,52%,55%,100%{filter:drop-shadow(0 0 12px rgba(255,20,147,0.5));opacity:1}
    19%,22%,54%{filter:drop-shadow(0 0 6px rgba(255,20,147,0.3));opacity:.85}
    35%{filter:drop-shadow(0 0 18px rgba(255,20,147,0.7));opacity:1}
  }
  /* Soft halo glow behind logo - separate layer, doesn't blur the logo itself */
  .glow-logo-wrap::before{
    content:"";
    position:absolute;
    inset:0;
    background:radial-gradient(ellipse 70% 60% at center, var(--hot-pink) 0%, var(--bubblegum) 30%, transparent 65%);
    opacity:.45;
    z-index:1;
    animation:halo-pulse 3s ease-in-out infinite;
    border-radius:50%;
    filter:blur(40px);
  }
  @keyframes halo-pulse{
    0%,100%{opacity:.4;transform:scale(1)}
    50%{opacity:.6;transform:scale(1.08)}
  }

  .hero-tagline{font-family:'Sacramento',cursive;font-weight:400;font-size:clamp(28px,3.4vw,48px);color:var(--deep);margin-bottom:18px;letter-spacing:.5px}
  .hero-headline{font-family:'Playfair Display',serif;font-weight:900;font-size:clamp(56px,9vw,160px);line-height:.92;letter-spacing:-3px;color:var(--deep);margin-bottom:30px;max-width:1100px}
  .hero-headline em{font-style:normal;font-family:'Sacramento',cursive;font-weight:400;font-size:1.15em;padding:0 8px;background:linear-gradient(135deg,var(--hot-pink),var(--magenta));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .hero-headline .scribble{position:relative;display:inline-block}
  .hero-headline .scribble::after{content:"";position:absolute;bottom:8px;left:-4px;right:-4px;height:14px;background:var(--hot-pink);z-index:-1;border-radius:50% / 100%;transform:rotate(-1.5deg);opacity:.35}
  .hero-sub{font-size:18px;line-height:1.7;color:var(--deep);max-width:560px;margin-bottom:40px;font-weight:400}
  .hero-ctas{display:flex;gap:14px;flex-wrap:wrap;justify-content:center}
  .call-fallback{margin-top:22px;font-family:'Outfit',sans-serif;font-size:13px;color:var(--charcoal);opacity:0.75;text-align:center;letter-spacing:0.3px}
  .call-fallback a{color:var(--hot-pink);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(255,20,147,0.3);transition:border-color .2s}
  .call-fallback a:hover{border-color:var(--hot-pink)}
  .cta-primary{background:var(--hot-pink);color:#fff;padding:18px 38px;border-radius:999px;border:none;font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;cursor:pointer;box-shadow:0 10px 30px rgba(255,20,147,0.45);transition:all .3s;text-decoration:none;display:inline-block}
  .cta-primary:hover{transform:translateY(-3px);box-shadow:0 16px 40px rgba(255,20,147,0.6)}
  .cta-secondary{background:transparent;color:var(--deep);padding:18px 38px;border-radius:999px;border:1.5px solid var(--deep);font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:all .3s;text-decoration:none;display:inline-block}
  .cta-secondary:hover{background:var(--ink);color:#fff}

  /* MARQUEE */
  .marquee{background:var(--hot-pink);color:#fff;padding:22px 0;overflow:hidden;border-top:2px solid var(--ink);border-bottom:2px solid var(--ink);transform:rotate(-1.5deg);margin:60px -20px;box-shadow:0 12px 40px rgba(255,20,147,0.3)}
  .marquee-track{display:flex;gap:50px;animation:scroll 9s linear infinite;white-space:nowrap}
  @media(max-width:780px){.marquee-track{animation-duration:7s}}
  .marquee-item{font-family:'Sacramento',cursive;font-size:46px;font-weight:400;display:flex;align-items:center;gap:50px}
  .marquee-item .sep{width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff}.marquee-item .sep::before{content:"";width:18px;height:18px;background:url("data:image/svg+xml;utf8,<svg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 24 24%27><path d=%27M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z%27 fill=%27%23ffffff%27/></svg>") center/contain no-repeat}
  @keyframes scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

  /* SECTION HEADERS */
  .section-header{text-align:center;margin-bottom:70px}
  .section-eyebrow{font-family:'Caveat',cursive;font-size:30px;color:var(--hot-pink);margin-bottom:8px;display:block;font-weight:700}
  .section-title{font-family:'Playfair Display',serif;font-weight:900;font-size:clamp(48px,7vw,112px);line-height:.95;letter-spacing:-2px;color:var(--deep)}
  .section-title em{font-style:normal;font-family:'Sacramento',cursive;font-weight:400;font-size:1.15em;color:var(--hot-pink);padding:0 6px}

  /* UGC */
  .ugc{padding:120px 40px;max-width:1400px;margin:0 auto;position:relative}
  .ugc-handle{text-align:center;font-family:'Outfit',sans-serif;font-weight:600;font-size:14px;color:var(--deep);letter-spacing:2px;text-transform:uppercase;margin-bottom:50px}
